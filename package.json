{
  "name": "weekly-learning-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check:connection": "node --env-file=.env scripts/check-connection.js",
    "activate:live": "node --env-file=.env scripts/check-connection.js --activate",
    "activate:local": "node --env-file=.env scripts/check-connection.js --local --activate"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": "24.x"
  }
}
