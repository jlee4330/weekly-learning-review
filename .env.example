# Default: local demo. No external calls, accounts, or credentials required.
VITE_MODE=demo
# local: real OpenAI voice/planning/evaluation, saved on this computer.
# Set VITE_MODE=local and REVIEW_STORAGE=local via npm run activate:local.
REVIEW_STORAGE=firebase
# Live: set VITE_MODE=live and supply Firebase public project configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Server only. NEVER prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_JUDGE_MODEL=gpt-4.1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=
PORT=3001

# Reuse the course's email/password Firebase Auth with loopback file storage.
# config/course-auth.json contains public project identifiers only.
# VITE_AUTH_PROVIDER=firebase
# REVIEW_AUTH=firebase
# Optional: mirror each student's weekly transcript to Firestore
# (students/{studentId} → Week1, Week2 … → transcript). Server only; keep the key in secrets/ (git-ignored).
TRANSCRIPT_FIREBASE_PROJECT_ID=
TRANSCRIPT_FIREBASE_CREDENTIALS=
# Deployment (Vercel): VITE_MODE=live, REVIEW_STORAGE=firebase, FIREBASE_PROJECT_ID=<data project>,
# and the data project's service-account JSON as one line (locally a file path in TRANSCRIPT_FIREBASE_CREDENTIALS works too).
FIREBASE_SERVICE_ACCOUNT=
# Any signed-in course account can use the review; set true to require courses/{courseId}/members/{uid}.
REQUIRE_ENROLLMENT=false
